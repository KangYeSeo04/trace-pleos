<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량 앱 전용 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- ===== 핵심 권한 ===== -->

    <!-- AAOS 표준 (CarPropertyManager) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />       <!-- 차량 속도 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />  <!-- 기어 -->

    <!-- Pleos Vehicle SDK -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- 브레이크, 조향각, 주행거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- 방향지시등 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />  <!-- EV 배터리 -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />    <!-- EV 배터리 용량 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" /> <!-- 공조 전원 상태 (읽기만) -->

    <!-- NaviHelper / TTS / STT -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- FusedLocation (dangerous). NaviHelper 위치가 멈춰 있을 때만 보조로 쓴다 (G-01) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <application
        android:name=".TraceApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trace">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Trace"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DO(Distraction Optimized) 메타데이터.
                 주행 중 화면 표시는 A-02 자동 복귀와 UX 제한 규칙으로 앱이 직접 보장 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>