<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- 차량 앱 전용 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos Vehicle SDK -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- 브레이크, 조향각 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- 방향지시등 -->
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />

    <!-- AAOS 표준 (CarPropertyManager) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />       <!-- 차량 속도 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />  <!-- 기어 -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trace">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Trace"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>